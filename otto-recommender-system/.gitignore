logs/

# Keep lightweight examples and final submission CSVs manageable.
!data/sample/
!data/sample/.gitkeep
!artifacts/submissions/
!artifacts/submissions/.gitkeep
!artifacts/reports/
!artifacts/reports/.gitkeep

# Common large local files
*.parquet
*.feather
*.pkl
*.joblib
*.npy
*.npz
*.csv
*.zip
*.7z
*.tar
*.gz

# Allow tiny documented examples if needed.
!data/sample/*.csv
!docs/*.csv
